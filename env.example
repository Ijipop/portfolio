# ===== CONFIGURATION DE LA BASE DE DONNÉES =====
# URL de connexion à votre base de données PostgreSQL (Neon.tech recommandé)
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://username:password@host:port/database?sslmode=require"

# ===== CONFIGURATION JWT =====
# Clé secrète pour signer les tokens JWT (générez une clé forte de 32+ caractères)
# En production, utilisez une clé complexe et gardez-la secrète
JWT_SECRET="your-super-secret-jwt-key-here-minimum-32-characters"

# ===== CONFIGURATION DE L'ENVIRONNEMENT =====
# Environnement d'exécution (development, production)
NODE_ENV="development"

# ===== CONFIGURATION DU SERVEUR =====
# URL de base de votre application (pour les cookies et redirections)
NEXTAUTH_URL="http://localhost:3000"

# ===== CONFIGURATION DE SÉCURITÉ =====
# Clé secrète pour NextAuth (si vous utilisez NextAuth plus tard)
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# ===== CONFIGURATION OPTIONNELLE =====
# Port du serveur (par défaut 3000)
PORT=3000

# ===== INSTRUCTIONS D'UTILISATION =====
# 1. Copiez ce fichier vers .env
# 2. Remplacez les valeurs par vos vraies configurations
# 3. Ne commitez JAMAIS le fichier .env dans Git
# 4. Pour JWT_SECRET, utilisez: openssl rand -base64 32
# 5. Pour NEXTAUTH_SECRET, utilisez: openssl rand -base64 32
